# 二进制产物
/kartwo
/dist-bin/
/dist/
*.exe

# AI 商品图保留本机 PNG 原稿；仓库仅提交经正式媒体管线压缩的 WebP 发布资源
/assets/generated-products/*.png

# 本机 AI 协作配置与内部规划文档（保留本地，不发布到开源仓库）
/.claude/
/AGENTS.md
/ARCHITECTURE.md
/CLAUDE.md
/CONVENTIONS.md
/DECISIONS.md
/PROGRESS.md
/ROADMAP.md

# 数据目录（数据即文件夹，绝不进 git）
/data/

# 本地工具链（go install 到此，不进 git）
/.bin/

# 前端依赖（构建期，不进 git）；构建产物 web/admin/dist 进 git 供 go build embed
/web/admin/ui/node_modules/
/web/admin/ui/.vite/

# 密钥与本地配置（绝不进 git）
*.env
.env
config.enc
*.pem
*.key

# 本地文档：人工测试说明 docs/test、完成报告 docs/reports（不进 git）
/docs/

# 编辑器/系统
.DS_Store
.idea/
.vscode/
*.swp
