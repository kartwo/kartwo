{
  "name": "kartwo-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kartwo Admin SPA / 后台管理界面",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:utilities && npm run test:react",
    "test:utilities": "node --test src/*.test.js",
    "test:react": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm test && npm run typecheck && vite build"
  },
  "dependencies": {
    "antd": "6.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  }
}
